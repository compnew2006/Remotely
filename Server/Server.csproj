<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>aspnet-Server-F297B939-4A64-4B42-8C70-E142EBDAA131</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileTag>remotely</DockerfileTag>
    <AssemblyName>Remotely_Server</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>

    <!--
      The compiled browser client lives in wwwroot/src, next to its sources,
      and it is committed to the repository.  That makes the files an output
      of the TypeScript build AND a required static web asset of the server.

      A clean removes the files that the TypeScript build produced, and the
      "no incremental" build option runs one before the build.  When the
      compile is skipped afterwards, the static web assets manifest fails
      with "No file exists for the asset at ... wwwroot/src/App.js" and the
      build stops with the compiled client missing from the working tree.

      With the incremental build of the TypeScript compiler turned off, the
      compile always runs and puts the files back, so the build cannot fail
      on a missing asset and the committed client is always regenerated from
      the committed sources.
    -->
    <TypeScriptEnableIncrementalMSBuild>false</TypeScriptEnableIncrementalMSBuild>
  </PropertyGroup>

  <!--
    The compiled browser client lives in wwwroot/src, next to its sources,
    and it is committed to the repository.  That makes the files an output of
    the TypeScript build AND a required static web asset of the server.

    A clean removes the files that the TypeScript build produced, and the
    "no incremental" build option runs one before the build.  When the
    compile is skipped afterwards, the static web assets manifest fails with
    "No file exists for the asset at ... wwwroot/src/App.js" and the build
    stops with the compiled client missing from the working tree.

    This target puts the client back before the manifest is written.  It only
    runs when a file is really missing, so the normal build is not affected.
  -->
  <Target Name="RestoreCompiledBrowserClient"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\src\App.js')">

    <Message Importance="high"
             Text="The compiled browser client is missing; it is compiled again before the build continues." />

    <Exec Command="node &quot;$(TSJavaScriptFile)&quot; --project &quot;$(MSBuildProjectDirectory)\wwwroot\src\tsconfig.json&quot;" />
  </Target>


  <ItemGroup>
    <PackageReference Include="Bitbound.SimpleMessenger" Version="2.3.14" />
    <PackageReference Include="CommunityToolkit.Diagnostics" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.33">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.6.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="System.CommandLine.NamingConventionBinder" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
