@inherits AuthComponentBase

<div class="row mb-2 g-2">
    <div class="col-sm-6">
        <input type="text" class="form-control form-control-sm" placeholder="Filter by name, window title, or id..."
               @bind="_filter" @bind:event="oninput" />
    </div>
    <div class="col-sm-6 text-end">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="taskManagerAutoRefresh" @bind="_autoRefresh" />
            <label class="form-check-label" for="taskManagerAutoRefresh">Auto-refresh</label>
        </div>
        <button class="btn btn-sm btn-primary" @onclick="RefreshAsync" disabled="@_isLoading">
            @(_isLoading ? "Loading..." : "Refresh")
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-warning py-2">@_errorMessage</div>
}

<div style="max-height: 55vh; overflow-y: auto;">
    <table class="table table-sm table-striped table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Process</th>
                <th>Id</th>
                <th>Session</th>
                <th>Memory (MB)</th>
                <th>CPU (s)</th>
                <th>Started</th>
                @if (HasWindowTitles)
                {
                    <th>Window</th>
                }
                <th style="width: 5rem;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var process in FilteredProcesses)
            {
                <tr @key="process.Id">
                    <td>@process.ProcessName</td>
                    <td>@process.Id</td>
                    <td>@process.SessionId</td>
                    <td>@process.MemoryMB.ToString("0.0")</td>
                    <td>@process.CpuSeconds.ToString("0.0")</td>
                    <td class="small text-nowrap">@process.StartTime</td>
                    @if (HasWindowTitles)
                    {
                        <td class="small text-truncate" style="max-width: 18rem;" title="@process.WindowTitle">@process.WindowTitle</td>
                    }
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => EndTaskAsync(process)">End</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (FilteredProcesses.Any() == false && _isLoading == false && string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="text-muted mt-2">No processes to show.</div>
}
