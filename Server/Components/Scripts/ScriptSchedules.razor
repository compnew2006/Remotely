@inherits AuthComponentBase
@attribute [Authorize]

<div class="script-schedules">
    <EditForm Model="_selectedSchedule" OnValidSubmit="OnValidSubmit" class="script-schedule-form">
        <DataAnnotationsValidator />

        <section class="script-panel" aria-label="Schedule details">
            <AlertBanner Message="@_alertMessage" OnClose="() => _alertMessage = string.Empty" />
            <ValidationSummary />

            <div class="script-panel-head">
                <div>
                    <h4 class="script-panel-title">Schedule details</h4>
                    <p class="script-hint">Choose a script and the devices or groups it should run on.</p>
                </div>

                <div class="script-panel-actions">
                    <button type="submit" class="btn btn-primary" disabled="@(!CanModifySchedule)">
                        Save
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CreateNew">
                        New
                    </button>
                    <button class="btn btn-outline-danger" type="button"
                            disabled="@(!CanDeleteSchedule)"
                            @onclick="DeleteSelectedSchedule">
                        Delete
                    </button>
                </div>
            </div>

            <div class="script-field-grid">
                <div class="script-field">
                    <label class="script-label" for="scheduleName">Schedule name</label>
                    <InputText id="scheduleName" class="form-control" @bind-Value="_selectedSchedule.Name" />
                </div>

                <div class="script-field">
                    <label class="script-label" for="scheduleStartAt">Start at</label>
                    <input id="scheduleStartAt" type="datetime-local" step="1" class="form-control" @bind="_selectedSchedule.StartAt" />
                </div>

                <div class="script-field">
                    <label class="script-label" for="scheduleInterval">Repeat interval</label>
                    <InputSelect id="scheduleInterval" @bind-Value="_selectedSchedule.Interval" class="form-control">
                        @foreach (var interval in Enum.GetValues<RepeatInterval>())
                        {
                            <option @key="@interval" value="@interval">@interval</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="script-check">
                <InputCheckbox id="scheduleRunOnNextConnect" class="form-check-input" @bind-Value="_selectedSchedule.RunOnNextConnect" />
                <label class="form-check-label" for="scheduleRunOnNextConnect">
                    If offline, run when next connected
                </label>
            </div>
        </section>

        <div class="script-picker-grid script-schedule-pickers">
            <section class="script-panel script-picker" aria-label="Saved scripts">
                <div class="script-panel-head">
                    <h4 class="script-panel-title">Saved scripts</h4>
                    <span class="script-count">@ParentPage.VisibleScriptCount</span>
                </div>

                <div class="script-check">
                    <input id="scheduleShowOnlyMine" class="form-check-input" type="checkbox" @bind="ParentPage.ShowOnlyMyScripts" />
                    <label class="form-check-label" for="scheduleShowOnlyMine">Show only mine</label>
                </div>

                <div class="script-tree">
                    @if (ParentPage.VisibleScriptCount == 0)
                    {
                        <div class="script-empty">
                            <i class="oi oi-script" aria-hidden="true"></i>
                            <span>No saved scripts yet. Create one on the Saved Scripts tab.</span>
                        </div>
                    }
                    else
                    {
                        <TreeView DataSource="ParentPage.TreeNodes"
                                  ItemTypeSelector="x => x.ItemType"
                                  ItemHeaderSelector="x => x.Name"
                                  ItemSelected="ScriptSelected"
                                  ChildItemSelector="x => x.ChildItems"
                                  ItemIconCssSelector="ParentPage.GetItemIconCss"
                                  KeySelector="x => x.Id"
                                  WrapperStyle="height: 100%;"
                                  T="ScriptTreeNode" />
                    }
                </div>
            </section>

            <section class="script-panel script-picker" aria-label="Device groups">
                <div class="script-panel-head">
                    <h4 class="script-panel-title">Device groups</h4>
                    <span class="script-count @(_selectedDeviceGroups.Count > 0 ? "is-active" : "")">
                        @_selectedDeviceGroups.Count / @_deviceGroups.Length
                    </span>
                </div>

                <div class="script-picker-list">
                    @if (_deviceGroups.Length == 0)
                    {
                        <div class="script-empty"><span>No device groups.</span></div>
                    }
                    else
                    {
                        @foreach (var deviceGroup in _deviceGroups)
                        {
                            <label class="script-option" @key="@deviceGroup.ID">
                                <input type="checkbox"
                                       checked="@(_selectedDeviceGroups.Contains(deviceGroup.ID))"
                                       @onchange="ev => DeviceGroupSelectedChanged(ev, deviceGroup)" />
                                <span>@deviceGroup.Name</span>
                            </label>
                        }
                    }
                </div>
            </section>

            <section class="script-panel script-picker" aria-label="Devices">
                <div class="script-panel-head">
                    <h4 class="script-panel-title">Devices</h4>
                    <span class="script-count @(_selectedDevices.Count > 0 ? "is-active" : "")">
                        @_selectedDevices.Count / @_devices.Length
                    </span>
                </div>

                <div class="script-picker-list">
                    @if (_devices.Length == 0)
                    {
                        <div class="script-empty"><span>No devices.</span></div>
                    }
                    else
                    {
                        @foreach (var device in _devices)
                        {
                            <label class="script-option" @key="@device.ID">
                                <input type="checkbox"
                                       checked="@(_selectedDevices.Contains(device.ID))"
                                       @onchange="ev => DeviceSelectedChanged(ev, device)" />
                                <span class="script-status @(device.IsOnline ? "is-online" : "is-offline")">
                                    @(device.IsOnline ? "Online" : "Offline")
                                </span>
                                <span>@device.DeviceName</span>
                            </label>
                        }
                    }
                </div>
            </section>
        </div>
    </EditForm>

    <section class="script-panel script-schedule-list" aria-label="Saved schedules">
        <div class="script-panel-head">
            <div>
                <h4 class="script-panel-title">Saved schedules</h4>
                <p class="script-hint">Select a row to edit its schedule.</p>
            </div>
            <span class="script-count">@_schedules.Count</span>
        </div>

        <div class="rm-table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Schedule name</th>
                        <th scope="col">Repeat interval</th>
                        <th scope="col">Next run</th>
                        <th scope="col">Last run</th>
                        <th scope="col">Created</th>
                        <th scope="col">Created by</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_schedules.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="script-empty">No schedules yet. Create one above.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var schedule in _schedules)
                        {
                            <tr @key="schedule.Id"
                                class="@GetTableRowClass(schedule)"
                                @onclick="async () => await SelectTableRow(schedule)">
                                <td>
                                    <button type="button"
                                            class="script-schedule-select"
                                            title="Select schedule to edit"
                                            @onclick="async () => await SelectTableRow(schedule)"
                                            @onclick:stopPropagation="true">
                                        @schedule.Name
                                    </button>
                                </td>
                                <td>@schedule.Interval</td>
                                <td>@schedule.NextRun.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(schedule.LastRun?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td>@schedule.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@schedule.Creator?.UserName</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
