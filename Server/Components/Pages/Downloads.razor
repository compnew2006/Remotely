@page "/downloads"
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Logging 

@inject IAuthService Auth
@inject IDataService DataService
@inject UserManager<RemotelyUser> UserManager
@inject IWebHostEnvironment HostEnv
@inject NavigationManager NavManager
@inject IJsInterop JsInterop
@inject IToastService Toasts
@inject ILogger<Downloads> Logger 

<div class="rm-page">
    <header class="rm-page-header">
        <h1 class="rm-page-title">Downloads</h1>
        <p class="rm-lead">
            Portable clients, resident agents, and install commands for this server.
        </p>
    </header>

    @if (_isAuthenticated)
    {
        <div class="rm-callout">
            Check out the <a href="/deploy">Deploy</a> page for a copy-and-paste deploy script!
        </div>
    }

    <section class="rm-section">
        <h2 class="rm-section-title">Portable Instant Support Clients</h2>
        <p class="rm-lead">
            Instant desktop sharing. No account required.
        </p>

        <div class="rm-grid">
            <article class="rm-panel">
                <h3 class="rm-panel-title">Windows (64-Bit)</h3>
                <ul class="rm-link-list">
                    <li>
                        <a class="rm-link" target="_blank" href="/api/ClientDownloads/Desktop/WindowsDesktop-x64/@_organizationId">
                            <span class="oi oi-data-transfer-download" aria-hidden="true"></span>Windows EXE
                        </a>
                    </li>
                </ul>
            </article>

            <article class="rm-panel">
                <h3 class="rm-panel-title">Windows (32-Bit)</h3>
                <ul class="rm-link-list">
                    <li>
                        <a class="rm-link" target="_blank" href="/api/ClientDownloads/Desktop/WindowsDesktop-x86/@_organizationId">
                            <span class="oi oi-data-transfer-download" aria-hidden="true"></span>Windows EXE
                        </a>
                    </li>
                </ul>
            </article>

            <article class="rm-panel">
                <h3 class="rm-panel-title">Linux 64-Bit</h3>
                <ul class="rm-link-list">
                    <li>
                        <a class="rm-link" target="_blank" href="/api/ClientDownloads/Desktop/UbuntuDesktop/@_organizationId">
                            <span class="oi oi-data-transfer-download" aria-hidden="true"></span>Ubuntu Executable
                        </a>
                    </li>
                </ul>
            </article>
        </div>
    </section>

    <section class="rm-section">
        <h2 class="rm-section-title">Resident Agents</h2>
        <p class="rm-lead">
            Installable background agents that provide unattended access and remote scripting.
        </p>

        @if (!_isAuthenticated)
        {
            <div class="rm-panel">
                <h3 class="rm-panel-title">Log in to download</h3>
                <p class="rm-note">
                    Resident agents are registered to your organization, so downloading one needs a signed-in account.
                </p>
                <a class="btn btn-primary mt-3" href="Account/Login">
                    <span class="oi oi-account-login" aria-hidden="true"></span> Log In
                </a>
            </div>
        }
        else
        {
            <div class="rm-grid rm-grid-wide">
                <article class="rm-panel">
                    <h3 class="rm-panel-title">Windows 10 / 11 (64-Bit and 32-Bit)</h3>
                    <ul class="rm-link-list">
                        <li>
                            <a class="rm-link" target="_blank" href="/API/ClientDownloads/WindowsInstaller/@_organizationId">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>Windows PowerShell Installer
                            </a>
                        </li>
                        <li>
                            <a class="rm-link" target="_blank" href="/Content/Remotely-Win-x64.zip">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>Windows x64 Files Only
                            </a>
                        </li>
                        <li>
                            <a class="rm-link" target="_blank" href="/Content/Remotely-Win-x86.zip">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>Windows x86 Files Only
                            </a>
                        </li>
                    </ul>
                </article>

                <article class="rm-panel">
                    <h3 class="rm-panel-title">Linux 64-Bit</h3>
                    <ul class="rm-link-list">
                        <li>
                            <a class="rm-link" target="_blank" href="/API/ClientDownloads/UbuntuInstaller-x64/@_organizationId">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>Ubuntu x64 Bash Installer
                            </a>
                        </li>
                        <li>
                            <a class="rm-link" target="_blank" href="/API/ClientDownloads/ManjaroInstaller-x64/@_organizationId">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>Manjaro x64 Bash Installer
                            </a>
                        </li>
                        <li>
                            <a class="rm-link" target="_blank" href="/Content/Remotely-Linux.zip">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>Linux x64 Files Only
                            </a>
                        </li>
                    </ul>
                </article>

                <article class="rm-panel">
                    <h3 class="rm-panel-title">macOS x64 (10.12 - 10.15)</h3>
                    <ul class="rm-link-list">
                        <li>
                            <a class="rm-link" target="_blank" href="/API/ClientDownloads/MacOSInstaller-x64/@_organizationId">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>macOS x64 Bash Installer
                            </a>
                        </li>
                        <li>
                            <a class="rm-link" target="_blank" href="/Content/Remotely-MacOS-x64.zip">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>macOS x64 Files Only
                            </a>
                        </li>
                    </ul>
                </article>

                <article class="rm-panel">
                    <h3 class="rm-panel-title">macOS arm64</h3>
                    <ul class="rm-link-list">
                        <li>
                            <a class="rm-link" target="_blank" href="/API/ClientDownloads/MacOSInstaller-arm64/@_organizationId">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>macOS arm64 Bash Installer
                            </a>
                        </li>
                        <li>
                            <a class="rm-link" target="_blank" href="/Content/Remotely-MacOS-arm64.zip">
                                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>macOS arm64 Files Only
                            </a>
                        </li>
                    </ul>
                </article>
            </div>
        }
    </section>

    @if (_isAuthenticated)
    {
        <section class="rm-section">
            <h2 class="rm-section-title">Install Examples</h2>
            <p class="rm-lead">
                Commands for installing and removing an agent on the target machine.
            </p>

            <div class="rm-grid rm-grid-wide">
                <article class="rm-panel">
                    <h3 class="rm-panel-title">Windows 10 / 11</h3>

                    <p class="rm-label">Example quiet install</p>
                    <pre class="rm-code">powershell.exe -ExecutionPolicy Bypass -F {path}\Install-Remotely.ps1
-install
-quiet
-organizationid "0b3d706b-9c5d-41e6-8ae9-5720d16324e6"
-serverurl "https://remotely.mytechshop.com"</pre>

                    <p class="rm-label mt-3">Example quiet uninstall</p>
                    <pre class="rm-code">powershell.exe -ExecutionPolicy Bypass -F Install-Remotely.ps1 -uninstall -quiet</pre>

                    <p class="rm-label mt-3">Example local install</p>
                    <pre class="rm-code">powershell.exe -ExecutionPolicy Bypass -F {path}\Install-Remotely.ps1
-install
-quiet
-organizationid "0b3d706b-9c5d-41e6-8ae9-5720d16324e6"
-serverurl "https://remotely.mytechshop.com"
-path "[path]\Remotely-Win-x64.zip"</pre>

                    <p class="rm-label mt-3">All override options</p>
                    <pre class="rm-code">powershell.exe -ExecutionPolicy Bypass -F {path}\Install-Remotely.ps1
-install -quiet -supportshortcut
-organizationid "0b3d706b-9c5d-41e6-8ae9-5720d16324e6"
-serverurl "https://remotely.mytechshop.com"
-devicegroup "Customer Group 1"
-devicealias "Front Desk"
-deviceuuid "eebb4d87-5459-4976-989e-a7876dffc69c"</pre>
                </article>

                <article class="rm-panel">
                    <h3 class="rm-panel-title">Linux 64-Bit</h3>

                    <p class="rm-label">Example install</p>
                    <pre class="rm-code">sudo [path]/Install-Ubuntu-x64.sh</pre>

                    <p class="rm-label mt-3">Example local install</p>
                    <pre class="rm-code">sudo [path]/Install-Ubuntu-x64.sh --path [path]/Remotely-Linux.zip</pre>

                    <p class="rm-label mt-3">Uninstall</p>
                    <pre class="rm-code">sudo [path]/Install-Ubuntu-x64.sh --uninstall</pre>
                </article>

                <article class="rm-panel">
                    <h3 class="rm-panel-title">macOS x64 (10.12 - 10.15)</h3>

                    <p class="rm-label">Example install</p>
                    <pre class="rm-code">sudo [path]/Install-MacOS-x64.sh</pre>

                    <p class="rm-label mt-3">Example local install</p>
                    <pre class="rm-code">sudo [path]/Install-MacOS-x64.sh --path [path]/Remotely-MacOS-x64.zip</pre>

                    <p class="rm-label mt-3">Example uninstall</p>
                    <pre class="rm-code">sudo [path]/Install-MacOS-x64.sh --uninstall</pre>
                </article>

                <article class="rm-panel">
                    <h3 class="rm-panel-title">macOS arm64</h3>

                    <p class="rm-label">Example install</p>
                    <pre class="rm-code">sudo [path]/Install-MacOS-arm64.sh</pre>

                    <p class="rm-label mt-3">Example local install</p>
                    <pre class="rm-code">sudo [path]/Install-MacOS-arm64.sh --path [path]/Remotely-MacOS-arm64.zip</pre>

                    <p class="rm-label mt-3">Example uninstall</p>
                    <pre class="rm-code">sudo [path]/Install-MacOS-arm64.sh --uninstall</pre>
                </article>
            </div>
        </section>
    }

    <section class="rm-section">
        <h2 class="rm-section-title">Helper Scripts</h2>
        <p class="rm-lead">
            Copy-and-paste commands for this server. Run them in an elevated PowerShell window on the target Windows machine.
        </p>

        <div class="rm-grid rm-grid-single">
            <article class="rm-panel rm-step">
                <div class="rm-step-head">
                    <h3 class="rm-step-title">1. Install the Windows agent (no account required)</h3>
                    <div class="rm-step-actions">
                        <button class="btn btn-sm rm-btn-ghost" type="button" @onclick="() => CopyScript(_installAgentScript)">
                            <span class="oi oi-clipboard" aria-hidden="true"></span> Copy
                        </button>
                    </div>
                </div>
                <pre class="rm-code">@_installAgentScript</pre>
                <p class="rm-note">
                    Downloads the installer for this server, installs the persistent agent, and registers Remotely_Service.
                </p>
            </article>

            <article class="rm-panel rm-step">
                <div class="rm-step-head">
                    <h3 class="rm-step-title">2. Protect the agent service (watchdog)</h3>
                    <div class="rm-step-actions">
                        <button class="btn btn-sm rm-btn-ghost" type="button" @onclick="() => CopyScript(_protectServiceScript)">
                            <span class="oi oi-clipboard" aria-hidden="true"></span> Copy
                        </button>
                    </div>
                </div>
                <pre class="rm-code">@_protectServiceScript</pre>
                <p class="rm-note">
                    Gives the service a clear name, restarts it automatically when it fails, registers a SYSTEM watchdog
                    that restarts it within a minute, and parks a stray portable Quick Support copy. It never touches
                    <code>Remotely\Desktop\Remotely_Desktop.exe</code>, which the agent needs for unattended control.
                </p>
            </article>

            <article class="rm-panel rm-step">
                <div class="rm-step-head">
                    <h3 class="rm-step-title">3. Undo the service protection</h3>
                    <div class="rm-step-actions">
                        <button class="btn btn-sm rm-btn-ghost" type="button" @onclick="() => CopyScript(_undoProtectionScript)">
                            <span class="oi oi-clipboard" aria-hidden="true"></span> Copy
                        </button>
                    </div>
                </div>
                <pre class="rm-code">@_undoProtectionScript</pre>
                <p class="rm-note">
                    Removes the watchdog and restores the original service name and the Quick Support executable.
                </p>
            </article>
        </div>
    </section>
</div>

@code {
    private const string InstallAgentScriptTemplate = """
        $script = "$env:TEMP\Install-Remotely.ps1"
        irm '__SERVER_URL__/Content/Install-Remotely.ps1' -OutFile $script
        powershell.exe -ExecutionPolicy Bypass -File $script `
          -ServerUrl '__SERVER_URL__' `
          -OrganizationId '__ORGANIZATION_ID__'
        """;

    private const string ProtectServiceScript = """
        $serviceName = 'Remotely_Service'
        $displayName = 'Arkan Remote Support - DO NOT STOP'

        # Start automatically and give the service an unmistakable name.
        sc.exe config $serviceName start= auto
        sc.exe config $serviceName DisplayName= "$displayName"

        # Restart the service on failure.
        sc.exe failure $serviceName reset= 900 actions= restart/5000/restart/10000/restart/30000

        # Watchdog: restart within a minute if anything stops the service.
        $cmd = "if ((Get-Service $serviceName -ErrorAction SilentlyContinue).Status -ne 'Running') { Start-Service $serviceName -ErrorAction SilentlyContinue }"
        $action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument "-NoProfile -WindowStyle Hidden -Command `"$cmd`""
        $trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddMinutes(1) -RepetitionInterval (New-TimeSpan -Minutes 1)
        $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
        Register-ScheduledTask -TaskName 'Remotely Service Watchdog' -Action $action -Trigger $trigger -Principal $principal -Force

        # Make sure it is running now.
        Start-Service $serviceName -ErrorAction SilentlyContinue

        # Park a stray portable "Quick Support" copy, if one was placed in the
        # install folder.  This is NOT the unattended app: the agent launches
        # "$env:ProgramFiles\Remotely\Desktop\Remotely_Desktop.exe" for every
        # remote control session, so that file must never be moved or renamed.
        $portableExe = Join-Path $env:ProgramFiles 'Remotely\Remotely_Desktop.exe'
        if (Test-Path $portableExe) { Move-Item $portableExe "$portableExe.disabled" -Force }

        Get-Service $serviceName | Format-List Name, DisplayName, Status, StartType
        """;

    private const string UndoProtectionScript = """
        Unregister-ScheduledTask -TaskName 'Remotely Service Watchdog' -Confirm:$false

        $portableExe = Join-Path $env:ProgramFiles 'Remotely\Remotely_Desktop.exe'
        if (Test-Path "$portableExe.disabled") { Move-Item "$portableExe.disabled" $portableExe -Force }

        sc.exe config Remotely_Service DisplayName= "Remotely Service"
        """;

    private string? _organizationId;
    private bool _isAuthenticated;
    private string _installAgentScript = string.Empty;
    private string _protectServiceScript = ProtectServiceScript;
    private string _undoProtectionScript = UndoProtectionScript;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await Auth.IsAuthenticated();

        if (_isAuthenticated)
        {
            var userResult = await Auth.GetUser();
            if (userResult.IsSuccess)
            {
                _organizationId = userResult.Value.OrganizationID;
            }
        }
        else
        {
            var orgResult = await DataService.GetDefaultOrganization();
            if (orgResult.IsSuccess)
            {
                _organizationId = orgResult.Value.ID;
            }
        }

        var serverUrl = NavManager.BaseUri.TrimEnd('/');
        _installAgentScript = InstallAgentScriptTemplate
            .Replace("__SERVER_URL__", serverUrl)
            .Replace("__ORGANIZATION_ID__", _organizationId ?? string.Empty);

        await base.OnInitializedAsync();
    }

    private async Task CopyScript(string script)
    {
        try
        {
            if (await JsInterop.SetClipboardText(script))
            {
                Toasts.ShowToast2("Script copied to clipboard", ToastType.Success);
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while copying script to clipboard.");
        }

        Toasts.ShowToast2("Failed to set clipboard content", ToastType.Error);
    }
}
