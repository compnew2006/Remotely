@page "/"
@inject IDataService DataService
 
<AuthorizeView>
    <NotAuthorized>
        <div class="rm-landing">
            <div class="rm-landing-panel">
                <h1 class="rm-page-title">Remotely</h1>
                <p class="rm-landing-lead">
                An open-source remote support solution.
                </p>
                <hr class="rm-landing-rule">
                <div class="rm-landing-actions">
                    <a class="btn btn-primary btn-lg" href="Account/Login" role="button">
                        <span class="oi oi-account-login" aria-hidden="true"></span> Log In
                    </a>

                    @if (_isRegistrationEnabled)
                    {
                        <a class="btn btn-lg rm-btn-ghost" href="Account/Register" role="button">Register</a>
                    }
                </div>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <AuthorizedIndex />
    </Authorized>
</AuthorizeView>

@code 
{
    private bool _isRegistrationEnabled;

    protected override async Task OnInitializedAsync()
    {
        var settings = await DataService.GetSettings();
        _isRegistrationEnabled = settings.MaxOrganizationCount < 0 || DataService.GetOrganizationCount() < settings.MaxOrganizationCount;
        await base.OnInitializedAsync();
    }
}
