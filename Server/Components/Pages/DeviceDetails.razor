@page "/device-details/{deviceId?}/{activeTab?}"

@attribute [Authorize]
@inherits AuthComponentBase


@if (string.IsNullOrWhiteSpace(DeviceId))
{
    <div class="row mt-5">
        <div class="col-md-8 col-lg-6">

            <h3>Device ID:</h3>
            <div class="input-group mb-2">
                <input type="text" class="form-control" placeholder="Enter a device ID to see its details"
                       @bind="_inputDeviceId"
                       @bind:event="oninput"
                       @onkeydown="EvaluateDeviceIdInputKeyDown">
                <div class="input-group-append">
                    <button class="btn btn-primary" @onclick="NavigateToDeviceId">Go</button>
                </div>
            </div>
            <div class="text-muted">
                You can also go directly to a device's details by:
                <ul>
                    <li>Right-clicking a device card on the main page while it's collapsed</li>
                    <li>Clicking the "Open in New Tab" button in a device card's header while it's expanded</li>
                </ul>
            </div>
        </div>
    </div>
}
else if (_isLoading)
{
    <h5>Loading...</h5>
}
else if (_device is null)
{
    <h3>Device not found.</h3>
}
else if (!_userHasAccess)
{
    <h3>Unauthorized.</h3>
}
else
{
    <TabControl InitialActiveTab="@(ActiveTab ?? "device")">
        <TabHeaders>
            <TabHeader Name="device" NavigationUri="@($"/device-details/{DeviceId}/device")">
                Details
            </TabHeader>
            <TabHeader Name="remote-logs" OnActivated="GetRemoteLogs" NavigationUri="@($"/device-details/{DeviceId}/remote-logs")">
                Remote Logs
            </TabHeader>
            <TabHeader Name="script-history" OnActivated="GetScriptHistory" NavigationUri="@($"/device-details/{DeviceId}/script-history")">
                Script History
            </TabHeader>
        </TabHeaders>

        <TabContents>
            <TabContent Name="device">
                <div class="device-details">
                    <div class="device-details-head">
                        <div class="device-details-title">
                            <h3 class="rm-page-title">Device Details</h3>
                            <div class="device-details-meta">
                                <span class="device-status-dot @( _device.IsOnline ? "is-online" : "is-offline")" aria-hidden="true"></span>
                                <span>@_device.DeviceName</span>
                                <span aria-hidden="true">·</span>
                                <span>@_device.Platform</span>
                                <span aria-hidden="true">·</span>
                                <span>Agent @_device.AgentVersion</span>
                            </div>
                        </div>
                        <div class="device-details-actions">
                    @if (!string.IsNullOrWhiteSpace(DeviceCapabilities.Notice))
                    {
                        <div class="alert alert-warning py-2" role="status">
                            @DeviceCapabilities.Notice
                        </div>
                    }

                    @if (_fileUploadProgressLookup.Any())
                    {
                        @foreach (var kvp in _fileUploadProgressLookup)
                        {
                            <div class="alert alert-info">
                                @(GetProgressMessage(kvp.Key))
                            </div>
                        }
                    }

                    <div class="mb-3 d-flex align-items-center gap-2">
                        <DropdownButton DropDownMenuClass="dropdown-menu-end mb-2" ButtonClass="btn-primary">
                            <ButtonContent>
                                <i class="oi oi-bolt"></i>
                                <span class="ms-2">Actions</span>
                            </ButtonContent>
                            <ChildListItems>
                                <li>
                                    <button class="dropdown-item" @onclick="StartChat"
                                            disabled="@(!IsFeatureAvailable(DeviceCapabilities.Chat))"
                                            title="@GetFeatureStatusLabel(DeviceCapabilities.Chat)">
                                        <i class="oi oi-chat" title="Chat"></i>
                                        <span class="ms-2">Chat</span>
                                        @if (DeviceCapabilities.Chat != FeatureSupport.Supported)
                                        {
                                            <span class="ms-2 small text-muted">@GetFeatureStatusLabel(DeviceCapabilities.Chat)</span>
                                        }
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="() => StartRemoteControl(false)"
                                            disabled="@(!IsFeatureAvailable(DeviceCapabilities.RemoteControl))"
                                            title="@GetFeatureStatusLabel(DeviceCapabilities.RemoteControl)">
                                        <i class="oi oi-laptop" title="Remote Control"></i>
                                        <span class="ms-2">Remote Control</span>
                                        @if (DeviceCapabilities.RemoteControl != FeatureSupport.Supported)
                                        {
                                            <span class="ms-2 small text-muted">@GetFeatureStatusLabel(DeviceCapabilities.RemoteControl)</span>
                                        }
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="() => StartRemoteControl(true)"
                                            disabled="@(!IsFeatureAvailable(DeviceCapabilities.RemoteControl))"
                                            title="@GetFeatureStatusLabel(DeviceCapabilities.RemoteControl)">
                                        <i class="oi oi-eye" title="View Only"></i>
                                        <span class="ms-2">View Only</span>
                                        @if (DeviceCapabilities.RemoteControl != FeatureSupport.Supported)
                                        {
                                            <span class="ms-2 small text-muted">@GetFeatureStatusLabel(DeviceCapabilities.RemoteControl)</span>
                                        }
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="ShowTaskManager"
                                            disabled="@(!IsFeatureAvailable(DeviceCapabilities.TaskManager))"
                                            title="@GetFeatureStatusLabel(DeviceCapabilities.TaskManager)">
                                        <i class="oi oi-task" title="Task Manager"></i>
                                        <span class="ms-2">Task Manager</span>
                                        @if (DeviceCapabilities.TaskManager != FeatureSupport.Supported)
                                        {
                                            <span class="ms-2 small text-muted">@GetFeatureStatusLabel(DeviceCapabilities.TaskManager)</span>
                                        }
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="ShowScreenshots"
                                            disabled="@(!IsFeatureAvailable(DeviceCapabilities.Screenshots))"
                                            title="@GetFeatureStatusLabel(DeviceCapabilities.Screenshots)">
                                        <i class="oi oi-image" title="Screenshots"></i>
                                        <span class="ms-2">Screenshots</span>
                                        @if (DeviceCapabilities.Screenshots != FeatureSupport.Supported)
                                        {
                                            <span class="ms-2 small text-muted">@GetFeatureStatusLabel(DeviceCapabilities.Screenshots)</span>
                                        }
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="ShowCamera"
                                            disabled="@(!IsFeatureAvailable(DeviceCapabilities.CameraRecording))"
                                            title="@GetFeatureStatusLabel(DeviceCapabilities.CameraRecording)">
                                        <i class="oi oi-video" title="Camera"></i>
                                        <span class="ms-2">Camera</span>
                                        @if (DeviceCapabilities.CameraRecording != FeatureSupport.Supported)
                                        {
                                            <span class="ms-2 small text-muted">@GetFeatureStatusLabel(DeviceCapabilities.CameraRecording)</span>
                                        }
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="ShowAudio"
                                            disabled="@(!IsFeatureAvailable(DeviceCapabilities.AudioRecording) && !IsFeatureAvailable(DeviceCapabilities.LiveAudio))"
                                            title="@GetAudioFeatureStatusLabel(DeviceCapabilities)">
                                        <i class="oi oi-audio-spectrum" title="Audio"></i>
                                        <span class="ms-2">Audio</span>
                                        @if (DeviceCapabilities.AudioRecording != FeatureSupport.Supported ||
                                            DeviceCapabilities.LiveAudio != FeatureSupport.Supported)
                                        {
                                            <span class="ms-2 small text-muted">@GetAudioFeatureStatusLabel(DeviceCapabilities)</span>
                                        }
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="ShowKeyboard"
                                            disabled="@(!IsFeatureAvailable(DeviceCapabilities.KeyboardCapture))"
                                            title="@GetFeatureStatusLabel(DeviceCapabilities.KeyboardCapture)">
                                        <i class="oi oi-key" title="Keyboard"></i>
                                        <span class="ms-2">Keyboard</span>
                                        @if (DeviceCapabilities.KeyboardCapture != FeatureSupport.Supported)
                                        {
                                            <span class="ms-2 small text-muted">@GetFeatureStatusLabel(DeviceCapabilities.KeyboardCapture)</span>
                                        }
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="() => WakeDevice()">
                                        <i class="oi oi-power-standby" title="Wake Device"></i>
                                        <span class="ms-2">Wake</span>
                                    </button>
                                </li>
                                <li>
                                    <FileInputButton ClassNames="dropdown-item btn btn-primary"
                                                     OnChanged="OnFileInputChanged">
                                        <ButtonContent>
                                            <i class="oi oi-data-transfer-upload" title="Upload File"></i>
                                            <span class="ms-2">Upload File</span>
                                        </ButtonContent>
                                    </FileInputButton>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="UpdateAgent">
                                        <i class="oi oi-reload" title="Update Agent"></i>
                                        <span class="ms-2">Update Agent</span>
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item bg-danger" @onclick="UninstallAgent">
                                        <i class="oi oi-delete" title="Uninstall"></i>
                                        <span class="ms-2">Uninstall</span>
                                    </button>
                                </li>
                            </ChildListItems>
                        </DropdownButton>
                        </div>
                    </div>
                    </div>

                    <div class="device-details-grid">
                    <section class="rm-panel device-preview-panel" aria-label="Screen preview">
                        <div class="rm-panel-head">
                            <h4 class="rm-panel-title">Screen Preview</h4>
                            <div class="form-check device-preview-auto">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="previewAuto-@_device.ID"
                                       checked="@_previewAutoEnabled"
                                       @onchange="(ChangeEventArgs e) => OnPreviewAutoChanged(e)" />
                                <label class="form-check-label" for="previewAuto-@_device.ID">Auto-refresh</label>
                            </div>
                        </div>
                        <div class="device-preview-tile-wrap">
                            <div class="preview-tile device-preview-tile">
                                @if (PreviewImageUrl is not null)
                                {
                                    <img src="@PreviewImageUrl" alt="Screen preview" class="preview-img" />
                                }
                                else
                                {
                                    <div class="preview-placeholder">
                                        <i class="oi oi-image"></i>
                                        <span class="small text-muted">No preview yet.</span>
                                    </div>
                                }
                                <button type="button"
                                        class="preview-refresh"
                                        title="Refresh preview now"
                                        aria-label="Refresh preview now"
                                        @onclick="RefreshPreviewNow">
                                    <i class="oi oi-reload"></i>
                                </button>
                            </div>
                            @if (_previewTimestamp is not null)
                            {
                                <div class="device-preview-caption small text-muted">
                                    Updated @_previewTimestamp.Value.ToLocalTime().ToString("HH:mm:ss") · every @_previewRefreshSeconds s
                                </div>
                            }
                        </div>
                    </section>

                    <section class="rm-panel device-facts-panel" aria-label="Device details">
                        <div class="rm-panel-head">
                            <h4 class="rm-panel-title">Device</h4>
                        </div>
                        <dl class="device-facts">
                            <div class="device-fact">
                                <dt>Device</dt>
                                <dd>@_device.DeviceName</dd>
                            </div>
                            <div class="device-fact">
                                <dt>Device ID</dt>
                                <dd class="device-fact-mono">@_device.ID</dd>
                            </div>
                            <div class="device-fact">
                                <dt>Agent Version</dt>
                                <dd>@_device.AgentVersion</dd>
                            </div>
                            <div class="device-fact">
                                <dt>Platform</dt>
                                <dd>@_device.Platform</dd>
                            </div>
                            <div class="device-fact">
                                <dt>OS</dt>
                                <dd>@_device.OSDescription</dd>
                            </div>
                            <div class="device-fact">
                                <dt>Disk</dt>
                                <dd>
                                    @MathHelper.GetFormattedPercent(_device.UsedStoragePercent)
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1" @onclick="ShowAllDisks">View All</button>
                                </dd>
                            </div>
                            @if (_device.TotalStorage > 0)
                            {
                                <div class="device-fact">
                                    <dt>Total Storage</dt>
                                    <dd>@_device.TotalStorage GB</dd>
                                </div>
                            }
                            <div class="device-fact">
                                <dt>Memory</dt>
                                <dd>@MathHelper.GetFormattedPercent(_device.UsedMemoryPercent)</dd>
                            </div>
                            <div class="device-fact">
                                <dt>Total Memory</dt>
                                <dd>@_device.TotalMemory GB</dd>
                            </div>
                            <div class="device-fact">
                                <dt>Public IP</dt>
                                <dd class="device-fact-mono">@_device.PublicIP</dd>
                            </div>
                            <div class="device-fact">
                                <dt>MAC Addresses</dt>
                                <dd class="device-fact-mono">@(string.Join(", ", _device.MacAddresses ?? Array.Empty<string>()))</dd>
                            </div>
                        </dl>
                    </section>
                    </div>

                    <section class="rm-panel device-edit-panel" aria-label="Settings">
                        <div class="rm-panel-head">
                            <h4 class="rm-panel-title">Settings</h4>
                        </div>
                    <EditForm Model="_device" OnValidSubmit="HandleValidSubmit" @onkeydown="EditFormKeyDown">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        @if (!string.IsNullOrWhiteSpace(_alertMessage))
                        {
                            <AlertBanner Message="@_alertMessage" />
                        }


                        <div class="device-edit-grid">
                        <div class="rm-field">
                            <label class="rm-field-label" for="device-alias">Device Alias</label>
                            <InputText class="form-control" id="device-alias" @bind-Value="@_device.Alias" />
                            <ValidationMessage For="() => _device.Alias" />
                        </div>
                        <div class="rm-field">
                            <label class="rm-field-label" for="device-groups">Device Group</label>
                            <InputSelect id="device-groups" @bind-Value="_device.DeviceGroupID" class="form-control">
                                <option value="">None</option>

                                @foreach (var group in _deviceGroups)
                                {
                                    <option @key="group.ID" value="@group.ID">@group.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _device.DeviceGroupID" />
                        </div>
                        <div class="rm-field">
                            <label class="rm-field-label" for="tags">Tags</label>
                            <InputText id="tags" @bind-Value="_device.Tags" class="form-control" />
                            <ValidationMessage For="() => _device.Tags" />
                        </div>
                        <div class="rm-field">
                            <label class="rm-field-label" for="notes">Notes</label>
                            <InputTextArea id="notes" @bind-Value="_device.Notes" class="form-control" rows="4"></InputTextArea>
                            <ValidationMessage For="() => _device.Notes" />
                        </div>
                        </div>
                        <div class="device-edit-actions">
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </EditForm>
                    </section>
                </div>
            </TabContent>

            <TabContent Name="remote-logs">
                <div class="py-3">
                    @if (!_device.IsOnline)
                    {
                        <h5 class="text-center mt-5">Device must be online to retrieve logs.</h5>
                    }
                    else
                    {
                        <div class="mb-2">
                            <button class="btn btn-primary me-2" @onclick="GetRemoteLogs">Refresh</button>
                            <button class="btn btn-danger" @onclick="DeleteLogs">Delete Logs</button>
                        </div>

                        @if (_logLines.Any())
                        {
                            <div style="white-space: pre;">
                                @foreach (var line in _logLines)
                                {
                                    @line
                                }
                            </div>
                        }
                        else
                        {
                            <LoadingSignal />
                        }
                    }

                </div>

            </TabContent>

            <TabContent Name="script-history">

                <h3 class="mb-3 mt-3">
                    Script History
                </h3>
                <table class="table table-dark table-hover table-striped">
                    <thead>
                        <tr>
                            <th>Shell</th>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Duration</th>
                            <th>Input</th>
                            <th>Output</th>
                            <th>Error</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var scriptResult in _scriptResults)
                        {
                            <tr>
                                <td>@scriptResult.Shell</td>
                                <td>@scriptResult.TimeStamp</td>
                                <td>@scriptResult.SenderUserName</td>
                                <td>@scriptResult.RunTime</td>
                                <td>@GetTrimmedText(scriptResult.ScriptInput, 25)</td>
                                <td>@GetTrimmedText(scriptResult.StandardOutput, 25)</td>
                                <td>@GetTrimmedText(scriptResult.ErrorOutput, 25)</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => ShowFullScriptOutput(scriptResult)">Show Full</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </TabContent>
        </TabContents>
    </TabControl>
}
