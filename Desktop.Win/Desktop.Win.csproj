<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Remotely_Desktop</AssemblyName>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <Description>Desktop client for allowing your IT admin to provide remote support.</Description>
    <Copyright>Copyright © 2023 Immense Networks</Copyright>
    <PackageId>Remotely Desktop</PackageId>
    <Authors>Jared Goodwin</Authors>
    <Company>Immense Networks</Company>
    <Product>Remotely Desktop</Product>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <StartupObject></StartupObject>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
  	<ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Remove="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\favicon.ico" />
    <None Remove="Assets\Remotely_Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Only the core types and the Wasapi/MMF layer are used.  The NAudio
      metapackage also brings NAudio.WinForms, which declares a framework
      reference to Microsoft.WindowsDesktop.App and adds the WinForms
      assemblies to the publish output for nothing.
    -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!--
      SystemEvents (session switch and display change notifications) used to
      arrive with the Microsoft.WindowsDesktop.App framework, which NAudio
      pulled in.  It is referenced explicitly now that the framework
      reference is gone.
    -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.15" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SkiaSharp.Views.Desktop.Common" Version="2.88.8" />
  </ItemGroup>

  <!--
    The camera capture uses ScreenRecorderLib, whose native library only
    supports the x86, x64, and ARM64 platforms.  The package fails the build
    on AnyCPU, so it is only referenced for the platforms that support it.
    The camera capture is not available in the AnyCPU build.
  -->
  <PropertyGroup Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'x86' Or '$(Platform)' == 'Win32' Or '$(Platform)' == 'ARM64' Or '$(PlatformTarget)' == 'x64' Or '$(PlatformTarget)' == 'x86' Or '$(PlatformTarget)' == 'ARM64' Or '$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-arm64'">
    <DefineConstants>$(DefineConstants);SCREEN_RECORDER_LIB</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'x86' Or '$(Platform)' == 'Win32' Or '$(Platform)' == 'ARM64' Or '$(PlatformTarget)' == 'x64' Or '$(PlatformTarget)' == 'x86' Or '$(PlatformTarget)' == 'ARM64' Or '$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-arm64'">
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Desktop.Shared\Desktop.Shared.csproj" />
    <ProjectReference Include="..\Desktop.UI\Desktop.UI.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\favicon.ico" />
    <EmbeddedResource Include="Assets\Remotely_Icon.png" />
  </ItemGroup>

  <!--
    ScreenRecorderLib ships a 15 MB pdb next to its assembly, and reference
    resolution copies it into the publish output.  The symbols of a
    third-party package are not needed on the device, and every device
    downloads this package.  The pdb files of this repository's own
    assemblies are kept, because the agent writes stack traces to its log.
  -->
  <Target Name="RemoveThirdPartySymbols" AfterTargets="Publish">
    <Delete Files="$(PublishDir)ScreenRecorderLib.pdb" Condition="Exists('$(PublishDir)ScreenRecorderLib.pdb')" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if $(SolutionDir) == *Undefined* (&#xD;&#xA;  exit 0&#xD;&#xA;)&#xD;&#xA;if $(ConfigurationName) == Debug (&#xD;&#xA;  if $(PlatformName) == AnyCPU (&#xD;&#xA;      md &quot;$(SolutionDir)Agent\bin\Debug\net10.0\Desktop\&quot;&#xD;&#xA;      xcopy &quot;$(TargetDir)*&quot; &quot;$(SolutionDir)Agent\bin\Debug\net10.0\Desktop\&quot; /y /e /i&#xD;&#xA;  )&#xD;&#xA;  if $(PlatformName) == x64 (&#xD;&#xA;      md &quot;$(SolutionDir)Agent\bin\x64\Debug\net10.0\Desktop\&quot;&#xD;&#xA;      xcopy &quot;$(TargetDir)*&quot; &quot;$(SolutionDir)Agent\bin\x64\Debug\net10.0\Desktop\&quot; /y /e /i&#xD;&#xA;  )&#xD;&#xA;  if $(PlatformName) == x86 (&#xD;&#xA;      md &quot;$(SolutionDir)Agent\bin\x86\Debug\net10.0\Desktop\&quot;&#xD;&#xA;      xcopy &quot;$(TargetDir)*&quot; &quot;$(SolutionDir)Agent\bin\x86\Debug\net10.0\Desktop\&quot; /y /e /i&#xD;&#xA;  )&#xD;&#xA;)" />
  </Target>

</Project>